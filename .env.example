# ═══════════════════════════════════════════════════════════════
# SANKA BOT DEPLOYER - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# Bot Configuration
BOT_NAME=Sanka Bot
BOT_PREFIX=.
OWNER_NUMBER=6281234567890

# Server Configuration
PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost:3000

# Session Configuration
SESSION_NAME=sanka-session

# Connection Settings
BROWSER_NAME=Sanka Bot
PRINT_QR=false

# Feature Toggles
MAINTENANCE_MODE=false
LOG_MESSAGES=true
AUTO_READ=false
AUTO_TYPING=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=10

# Logging
LOG_LEVEL=info
LOG_TO_FILE=false

# Web Panel Authentication
PANEL_AUTH_ENABLED=false
PANEL_USERNAME=admin
PANEL_PASSWORD=admin123

# Anti-Spam
ANTI_SPAM_ENABLED=true

# Auto Response
AUTO_RESPONSE_ENABLED=false

# Group Settings
WELCOME_ENABLED=true
GOODBYE_ENABLED=true

# AI Mode (Qwen via Dashscope)
QWEN_API_KEY=your_dashscope_api_key_here
